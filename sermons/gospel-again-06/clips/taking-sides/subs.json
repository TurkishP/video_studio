[
 {"text": "직장에서 다\n관계에 *문제*가 생기죠", "en": "At work, relationships go wrong."},
 {"text": "교회 안에서도\n마찬가지입니다", "en": "It's the same at church,"},
 {"text": "가정에서도\n마찬가지예요", "en": "and the same at home."},
 {"text": "관계에 문제가\n생기는 이유는", "en": "Why do relationships break down?"},
 {"text": "*교만* 때문이에요", "en": "Pride."},
 {"text": "교만은 교만을\n*용납*하지 못합니다", "en": "Pride can't stand pride.", "hand": true},
 {"text": "*겸손*이 교만을\n용납할 수 있는 거예요", "en": "Only humility can bear with pride."},
 {"text": "교만은 딱 알아요\n교만한 인간을", "en": "Pride spots a proud person instantly,"},
 {"text": "그래서 딱 *싫어합니다*", "en": "and can't stand them."},
 {"text": "그런 행동을\n용납할 수가 없어요", "en": "It can't put up with that behavior,"},
 {"text": "교만하기 때문이죠", "en": "because it's proud itself."},
 {"text": "겸손은 교만과\n*같이* 갈 수 있습니다", "en": "Humility can walk alongside pride."},
 {"text": "당을 지어 이것은\n자기 자신을", "en": "\"Forming factions\": when you seek yourself,"},
 {"text": "자기의 *이익*을\n추구할 때", "en": "your own interest,"},
 {"text": "결국 *당파*를 만들죠\n당을 짓습니다", "en": "you end up taking sides."},
 {"text": "왜? 내 *편*을\n만들어야 되거든", "en": "Why? You need people on your side."},
 {"text": "내가 진리가\n아니기 때문에", "en": "You aren't the truth,"},
 {"text": "나 혼자\n주장할 수는 없거든", "en": "so you can't make your case alone."},
 {"text": "그래서 누군가의\n편을 만듭니다", "en": "So you recruit allies."},
 {"text": "그래서 직장에서\n이 인간이 나를 힘들게 하고", "en": "So at work, this guy gives you a hard time,"},
 {"text": "저 인간이 나를\n힘들게 하면", "en": "that guy makes your life hard,"},
 {"text": "그거를 얘기하면서", "en": "and you talk about it"},
 {"text": "내 친구들에게\n*편*을 얻는 거죠", "en": "to win your friends to your side."},
 {"text": "내 친구들은 이 사람이\n어떤지 모르면서", "en": "Your friends don't even know the person,"},
 {"text": "*욕*해 주죠", "en": "but they bad-mouth them for you."},
 {"text": "그러면서 자기를\n*강화*시킵니다", "en": "And that's how you reinforce yourself:"},
 {"text": "\"내가 *맞다*\"고", "en": "\"I'm right.\"", "hand": true}
]
