[
 {"text": "제가 아는 목사님 중에\n*친한* 목사님이", "en": "A pastor friend of mine"},
 {"text": "어디 *세미나*를 갔다 왔어요", "en": "went to a seminar"},
 {"text": "세미나 강사로 갔다 왔는데", "en": "as a speaker,"},
 {"text": "교회 *브랜딩*에 대한\n세미나를 갔다 왔습니다", "en": "a seminar on church branding."},
 {"text": "그러면서 교회를\n어떻게 브랜딩 해야 되느냐에", "en": "It walked through how churches"},
 {"text": "대해서 쭉 소개를 했어요", "en": "should brand themselves."},
 {"text": "그런데 이분이 갔다 와서\n*전화*하면서", "en": "When he got back, he called me:"},
 {"text": "\"목사님 내가 제일", "en": "\"Pastor, I realized"},
 {"text": "안 *어울리는* 사람이라는 걸\n알았다는 거예요", "en": "I'm the one who fits in least.\""},
 {"text": "다 교회들 *화려*하고\n뭐 다 하는데", "en": "The churches are all flashy and do it all,"},
 {"text": "자기는 이제 그런 것과는\n좀 머니까", "en": "and he's far from all that."},
 {"text": "그러면서 교회 브랜딩이\n필요는 한데", "en": "Branding is needed, he said,"},
 {"text": "뭔가 좀 *찝찝*하다는 거예요\n갔다 와서", "en": "but it left him uneasy."},
 {"text": "왜냐하면 *개척교회*들이\n무슨 브랜딩을 어떻게 해요?", "en": "How is a church plant supposed to do branding?"},
 {"text": "다 *돈*도 없고", "en": "None of them have money."},
 {"text": "무대도 이렇게\n설교와 비슷하게", "en": "Redo the stage to match the sermon,"},
 {"text": "무대도 미술로\n이렇게 바꿔야 되고", "en": "turn the stage into art..."},
 {"text": "미국에 있는 어떤 교회는\n설교 시리즈 하면서", "en": "One church in America, for a sermon series,"},
 {"text": "*탱크*를 갖다 놓습니다\n여기 위에 생생하게", "en": "put a real tank right up on stage."},
 {"text": "그런 걸 따라 할 수 없잖아요", "en": "We can't copy that."},
 {"text": "그러면서 이 *브랜딩*에 대해서", "en": "So he asked me"},
 {"text": "어떻게 생각을 하느냐\n저한테 물었어요", "en": "what I thought about branding."},
 {"text": "그걸 가지고\n제가 좀 고민하다가", "en": "I thought it over,"},
 {"text": "그런 생각이 들었습니다", "en": "and here's where I landed."},
 {"text": "브랜딩 *필요*합니다", "en": "Branding is necessary."},
 {"text": "필요하다고 생각하고\n할 수 있으면", "en": "I think it's needed, and if you can,"},
 {"text": "*예쁘게* 보이는 게\n훨씬 더 좋죠", "en": "looking good is much better."},
 {"text": "그런데 정말\n브랜딩의 *핵심*이라는 것은", "en": "But the real heart of branding"},
 {"text": "건강한 *복음적 공동체*죠", "en": "is a healthy gospel community."},
 {"text": "사도행전의 교회가\n브랜딩을 통해서", "en": "The church in Acts"},
 {"text": "성장한 교회는 아니잖아요", "en": "didn't grow through branding."},
 {"text": "브랜딩을 잘하고\n*마케팅*을 잘해서", "en": "It wasn't good branding and marketing"},
 {"text": "사람들이 마음을\n사로잡았던 것이 아니라", "en": "that won people's hearts."},
 {"text": "복음적 공동체가 가지는\n그 *힘*이죠", "en": "It was the power of a gospel community."},
 {"text": "그것이 정말 *브랜딩*이죠", "en": "That's real branding."},
 {"text": "진정한 브랜딩은\n*디자인*의 아름다움이 아니라", "en": "True branding isn't the beauty of design,", "hand": true},
 {"text": "*공동체*의 아름다움이다", "en": "it's the beauty of community.", "hand": true}
]
