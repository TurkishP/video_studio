[
 {"text": "결혼식 할 때\n서약할 때", "en": "At a wedding, during the vows,"},
 {"text": "주로 *기도*시키는\n이유가 뭡니까?", "en": "why do we usually pray?"},
 {"text": "인간의 능력으로는\n*사랑*할 수가 없어요", "en": "Human strength can't love."},
 {"text": "그 사람을\n사랑할 수가 없습니다", "en": "You can't love that person on your own."},
 {"text": "*은혜*가 필요한 거죠", "en": "You need grace."},
 {"text": "하나님의 은혜가\n필요한 거예요", "en": "You need God's grace."},
 {"text": "사랑하고 결혼하면\n좋아집니까?", "en": "Does marrying for love make it easy?"},
 {"text": "인간은 타락한 본성을\n갖고 있기 때문에", "en": "We have a fallen nature, so"},
 {"text": "사랑해서 결혼했지만", "en": "even if you married for love,"},
 {"text": "결혼생활 한 *10년* 정도\n될 때까지는", "en": "for about the first ten years"},
 {"text": "계속 *헤어지고* 싶어요", "en": "you keep wanting to split up."},
 {"text": "계속 그 마음이 듭니다", "en": "That feeling keeps coming back."},
 {"text": "우리 송민 집사님께\n제가 물어봤더니", "en": "I asked our Deacon Song-min,"},
 {"text": "\"집사님, *30년* 되면\n어떻습니까?\"", "en": "\"What about after 30 years?\""},
 {"text": "\"똑같다\"\n그러시더라고요", "en": "\"Same,\" he said.", "hand": true},
 {"text": "힘든 거는 힘든 거예요", "en": "Hard is hard."},
 {"text": "어려운 건 어려운 거고", "en": "Difficult is difficult."},
 {"text": "그 과정 속에서\n서로 *하나*가 된다는 것은", "en": "Becoming one in that process"},
 {"text": "자기를 깎아가는\n그런 연합을 통해서", "en": "happens through a union that wears down the self,"},
 {"text": "훈련을 통해서\n이루어지는 자유지", "en": "a freedom won through training."},
 {"text": "그냥 원하는 *자유*라는 것은\n존재하지 않습니다", "en": "Freedom to just do as you please doesn't exist."}
]
