[
 {"text": "기독교는 어떻게 세계를\n지배하는 *종교*가 되었을까", "en": "How did Christianity become the world's leading religion?", "zoom": false},
 {"text": "라는 질문을 던져요", "en": "That's the question.", "zoom": false},
 {"text": "로마 인구가 *10%*가\n죽게 만들었던", "en": "Once an epidemic killed a tenth of Rome,", "zoom": false},
 {"text": "그런 *페스트* 같은 어떤\n전염병이 돈 적이 있습니다", "en": "something like the plague.", "zoom": false},
 {"text": "그러니까 전염병이 도니까\n사람들은 다 *도망*갔어요", "en": "As it spread, everyone fled.", "zoom": false},
 {"text": "그런데 기독교인들은\n죽음을 두려워하지 않는", "en": "But the Christians had a faith that didn't fear death,", "zoom": false},
 {"text": "그런 *부활*의 신앙을\n좀 가지고 있었습니다", "en": "a resurrection faith.", "zoom": false},
 {"text": "그래서 누군가가\n전염병에 걸리면", "en": "So when someone caught the disease,", "zoom": false},
 {"text": "그 사람들의 *시체*를\n치워줬어요", "en": "they cleared away the bodies.", "zoom": false},
 {"text": "기독교인들이 치워줬어요", "en": "The Christians did.", "zoom": false},
 {"text": "다른 사람들은 건드리면\n내가 *전염*될까 봐 다 놔뒀는데", "en": "Everyone else left them, afraid of catching it.", "zoom": false},
 {"text": "그래서 기독교인들이 그걸 다\n그 동네에서는", "en": "So in their towns the Christians", "zoom": false},
 {"text": "*시체*를 치워주고 사람들을\n이렇게 *도와주고* 했단 말이에요", "en": "cleared the bodies and cared for people.", "zoom": false},
 {"text": "그러니까 훨씬 더\n*위생*적이 됐죠 시체가 없으니까", "en": "It got much cleaner, with no bodies lying around.", "zoom": false},
 {"text": "그래서 다른 지역에서는\n이 시체를 계속 놔두니까", "en": "Elsewhere the bodies stayed,", "zoom": false},
 {"text": "계속 전염병이 도는데", "en": "and the disease kept spreading.", "zoom": false},
 {"text": "기독교인들이 있었던\n그 지역에는", "en": "But where the Christians were,", "zoom": false},
 {"text": "훨씬 더 *감염*이 덜 되고", "en": "far fewer were infected,", "zoom": false},
 {"text": "사람들이 많이 치료되고\n*회복*이 됐단 말이에요", "en": "and many were healed and recovered.", "zoom": false},
 {"text": "그 이후에 로마에서\n많은 사람들이", "en": "After that, many in Rome", "zoom": false},
 {"text": "기독교로 *회심*하고\n개종을 했습니다", "en": "turned to Christ and converted.", "zoom": false},
 {"text": "*은혜*는 세상과\n타인 지향성으로", "en": "Grace always flows outward,", "hand": true, "zoom": false},
 {"text": "나가게 돼 있죠", "en": "toward the world and other people.", "hand": true, "zoom": false},
 {"text": "그리고 로마 사회와는 달리\n*낙태*와 영아 살해를 금하고", "en": "Unlike Roman society, they banned abortion and infanticide,", "zoom": false},
 {"text": "*결혼*과 자녀 출산을 장려했고", "en": "encouraged marriage and children,", "zoom": false},
 {"text": "사회적 지위에서\n*여성*과 남성을", "en": "and treated women and men", "zoom": false},
 {"text": "동등히 여겼습니다", "en": "as equals.", "zoom": false},
 {"text": "그 *문화*가\n세상을 바꾸는 거죠", "en": "That culture is what changes the world.", "hand": true, "zoom": false}
]
